// =====================================================================
//  قواعد Firestore الكاملة — الغرباوي (منيو + إدارة + فروع + ولاء + إشعارات)
//  اتبنت من استخدام الكود الفعلي لكل كولكشن. خد نسخة من قواعدك القديمة قبل ما تبدّل.
//  للنشر: Firebase Console ← Firestore ← Rules ← امسح اللي موجود ← الصق ده ← Publish
// =====================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- دوال مساعدة ----------
    function hasProfile() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function active()     { return hasProfile() && profile().get('active', true) != false; }
    function role()       { return hasProfile() ? profile().get('role', '') : ''; }
    function isSuper()    { return active() && role() == 'super_admin'; }
    function isOwner()    { return active() && role() in ['super_admin', 'admin']; }
    function isBranchMgr(){ return active() && role() == 'branch_manager'; }
    function isCaptain()  { return active() && role() == 'captain'; }
    function isStaff()    { return isOwner() || isBranchMgr() || isCaptain(); }
    function sameBranchAny(branchId) {
      return (isBranchMgr() || isCaptain()) && profile().get('branchId', '') == branchId;
    }
    function sameBranch(branchId) {
      return isBranchMgr() && profile().get('branchId', '') == branchId;
    }

    // ---------- المنيو (الكل يقرأ، الأدمن يكتب) ----------
    match /menu/{id}       { allow read: if true; allow write: if isOwner(); }
    match /categories/{id} { allow read: if true; allow write: if isOwner(); }
    match /offers/{id}     { allow read: if true; allow write: if isOwner(); }
    match /menus/{id}      { allow read: if isStaff(); allow write: if isOwner(); }

    // ---------- الفروع (مدير الفرع يعدّل المخزون بس) ----------
    match /branches/{branchId} {
      allow read: if true;
      allow create, delete: if isOwner();
      allow update: if isOwner()
        || (sameBranch(branchId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockOverrides']));
    }

    // ---------- الإعدادات ----------
    match /settings/features      { allow read: if true; allow write: if isOwner(); }
    match /settings/loyalty       { allow read: if true; allow write: if isOwner(); }
    match /settings/pickup        { allow read: if true; allow write: if isOwner(); }
    match /settings/loyalty_msgs  { allow read: if true; allow write: if isOwner(); }
    match /settings/{other}       { allow read, write: if isOwner(); }

    // ---------- المستخدمين (الأدمن يدير، والسوبر أدمن بس يتعامل مع سوبر أدمن) ----------
    match /users/{uid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow create: if isSuper() || (isOwner() && request.resource.data.role != 'super_admin');
      allow update: if isSuper()
        || (isOwner() && resource.data.role != 'super_admin' && request.resource.data.role != 'super_admin');
      allow delete: if isSuper() || (isOwner() && resource.data.role != 'super_admin');
    }

    // ---------- الأوردرات ----------
    // العميل بيعمل أوردر وبيتابع حالته (من غير تسجيل دخول)، والفرع/الأدمن بيغيّروا الحالة
    match /orders/{id} {
      // ملكية موثّقة: الأوردر مربوط بـ guestUid = هوية تسجيل الدخول المجهول للعميل.
      // أوردرات قديمة من غير guestUid: fail-closed — مش مقروءة من أي عميل (الموظفين بس).
      function isGuestOwner() {
        return request.auth != null && resource.data.guestUid == request.auth.uid;
      }
      allow get: if isStaff() || isGuestOwner();
      allow list: if isStaff();
      allow create: if request.auth != null
                    && request.resource.data.guestUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.items is list
                    && request.resource.data.total is number
                    && request.resource.data.branchId is string;
      allow update: if isOwner()
        || (sameBranchAny(resource.data.branchId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelReason','cancelledBy','cancelledAt','wasted','paymentStatus','paidAt','paidBy']))
        || (isGuestOwner()
            && resource.data.get('type', '') == 'pickup'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['arrived','arrivedAt','etaMin','distanceM','bay']))
        || (isGuestOwner()
            && resource.data.get('type', '') == 'pickup'
            && resource.data.get('payment', '') == 'wallet'
            && resource.data.get('paymentStatus', '') != 'paid'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentRef','paymentSentAt']))
        || (isGuestOwner()
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelReason','cancelledBy','cancelledAt'])
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledBy == 'customer');
      allow delete: if isOwner();
    }

    // ---------- نداء الويتر ----------
    match /waiter_calls/{id} {
      // نفس نموذج الملكية: النداء مربوط بصاحبه، والليست للموظفين
      allow get: if isStaff()
        || (request.auth != null && resource.data.guestUid == request.auth.uid);
      allow list: if isOwner() || sameBranchAny(resource.data.branchId);
      allow create: if request.auth != null
                    && request.resource.data.guestUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.branchId is string;
      allow update: if isOwner()
        || (sameBranchAny(resource.data.branchId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isOwner();
    }

    // ---------- التقييمات ----------
    match /order_feedback/{id} {
      allow create: if request.resource.data.stars is number
                    && request.resource.data.stars >= 0 && request.resource.data.stars <= 5
                    && (!('comment' in request.resource.data)
                        || (request.resource.data.comment is string && request.resource.data.comment.size() <= 500));
      allow read: if isStaff();
      allow update: if false;
      allow delete: if isOwner();
    }
    match /item_ratings/{id} {
      allow read: if true;
      // الهوية = uid تسجيل الدخول المجهول، مش deviceId معرّف ذاتياً
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.stars is number
                    && request.resource.data.stars >= 0 && request.resource.data.stars <= 5;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stars','orderId','updatedAt']);
      allow delete: if isOwner();
    }

    // ---------- الهالك (أوردرات اتحضّرت واتلغت) ----------
    match /waste_log/{id} {
      allow create: if isStaff() && request.resource.data.branchId is string
                    && (isOwner() || sameBranchAny(request.resource.data.branchId));
      allow read: if isOwner() || (isBranchMgr() && resource.data.branchId == profile().get('branchId', ''));
      allow update, delete: if isOwner();
    }

    // ---------- عملاء "ماجاش" (الـ id هاش للموبايل، مفيش قراءة جماعية) ----------
    match /noshow/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isStaff() && request.resource.data.keys().hasOnly(['count','last','branchId'])
                            && request.resource.data.count is number;
      allow delete: if isOwner();
    }

    // ---------- إشعارات الإدارة الداخلية ----------
    match /notifications/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isOwner();
    }

    // =================== الولاء والإشعارات ===================
    // العملاء: الـ id عشوائي ومتخمنش. العميل يقرأ كارته بالـ id بس، والموظفين يشوفوا الكل
    match /loyalty_members/{id} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(['name','phone','stamps','redeemed','visits','joinedAt','lastVisit'])
                    && request.resource.data.stamps == 0
                    && request.resource.data.redeemed == 0
                    && request.resource.data.visits == 0
                    && request.resource.data.name is string && request.resource.data.name.size() <= 40
                    && request.resource.data.phone is string && request.resource.data.phone.size() <= 15;
      allow update, delete: if isStaff();
    }

    // سجل الأختام (للموظفين)
    match /loyalty_log/{id} {
      allow read, create: if isStaff();
    }

    // رسائل الإدارة للعملاء (الكل يقرأ، الأدمن بس ينشر)
    match /loyalty_broadcasts/{id} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // أجهزة Push (المرحلة 2): العميل يسجّل جهازه بس
    match /loyalty_push_tokens/{id} {
      allow create, update: if request.resource.data.keys().hasOnly(['memberId','token','url','at'])
                            && request.resource.data.memberId == id
                            && request.resource.data.token is string
                            && request.resource.data.token.size() < 400;
      allow read, delete: if isStaff();
    }
  }
}
